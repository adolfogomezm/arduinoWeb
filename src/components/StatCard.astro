---
interface Props {
  title: string;
  value: string | number;
  unit?: string;
  min?: number;
  max?: number;
  type?: 'temperature' | 'humidity' | 'fan' | 'count';
  iconType?: string;
}

const { title, value, unit = '', min, max, type = 'count' } = Astro.props;

const colorThemes = {
  temperature: {
    border: 'border-orange-500/20 hover:border-orange-500/40',
    glow: 'from-orange-500/10 via-amber-500/5 to-transparent',
    iconBg: 'bg-orange-500/10 text-orange-400 border border-orange-500/20',
    accentText: 'text-orange-400',
    barFill: 'bg-gradient-to-r from-amber-400 to-orange-500',
  },
  humidity: {
    border: 'border-cyan-500/20 hover:border-cyan-500/40',
    glow: 'from-cyan-500/10 via-blue-500/5 to-transparent',
    iconBg: 'bg-cyan-500/10 text-cyan-400 border border-cyan-500/20',
    accentText: 'text-cyan-400',
    barFill: 'bg-gradient-to-r from-cyan-400 to-blue-500',
  },
  fan: {
    border: 'border-purple-500/20 hover:border-purple-500/40',
    glow: 'from-purple-500/10 via-indigo-500/5 to-transparent',
    iconBg: 'bg-purple-500/10 text-purple-400 border border-purple-500/20',
    accentText: 'text-purple-400',
    barFill: 'bg-gradient-to-r from-purple-400 to-indigo-500',
  },
  count: {
    border: 'border-emerald-500/20 hover:border-emerald-500/40',
    glow: 'from-emerald-500/10 via-teal-500/5 to-transparent',
    iconBg: 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20',
    accentText: 'text-emerald-400',
    barFill: 'bg-gradient-to-r from-emerald-400 to-teal-500',
  },
};

const theme = colorThemes[type] || colorThemes.count;
---

<div class={`relative overflow-hidden rounded-2xl bg-slate-900/70 border ${theme.border} p-6 backdrop-blur-md shadow-lg shadow-black/20 transition-all duration-300 hover:-translate-y-0.5`}>
  <!-- Gradient top highlight -->
  <div class={`absolute inset-0 bg-gradient-to-br ${theme.glow} pointer-events-none`}></div>

  <div class="relative z-10 flex flex-col justify-between h-full">
    <div class="flex items-center justify-between mb-4">
      <span class="text-xs font-semibold tracking-wider uppercase text-slate-400">{title}</span>
      <div class={`p-2.5 rounded-xl ${theme.iconBg}`}>
        {type === 'temperature' && (
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z"></path>
          </svg>
        )}
        {type === 'humidity' && (
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"></path>
          </svg>
        )}
        {type === 'fan' && (
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 12c0-3 2.5-5 5-5s3 2.5 3 5-2.5 5-5 5c0 3-2.5 5-5 5s-3-2.5-3-5 2.5-5 5-5c0-3-2.5-5-5-5s-3 2.5-3 5 2.5 5 5 5"></path>
            <circle cx="12" cy="12" r="2"></circle>
          </svg>
        )}
        {type === 'count' && (
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
            <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
            <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
          </svg>
        )}
      </div>
    </div>

    <div class="flex items-baseline gap-2 mb-3">
      <span class="text-4xl font-extrabold tracking-tight text-white font-mono">{value}</span>
      {unit && <span class={`text-lg font-bold ${theme.accentText}`}>{unit}</span>}
    </div>

    {(min !== undefined && max !== undefined) ? (
      <div class="pt-3 border-t border-slate-800/80 mt-auto flex items-center justify-between text-xs text-slate-400">
        <div class="flex items-center gap-1.5">
          <span class="text-slate-500">Mín:</span>
          <span class="font-mono font-medium text-slate-200">{min}{unit}</span>
        </div>
        <div class="h-3 w-px bg-slate-800"></div>
        <div class="flex items-center gap-1.5">
          <span class="text-slate-500">Máx:</span>
          <span class="font-mono font-medium text-slate-200">{max}{unit}</span>
        </div>
      </div>
    ) : (
      <div class="pt-3 border-t border-slate-800/80 mt-auto text-xs text-slate-400 flex items-center gap-1.5">
        <span class="w-2 h-2 rounded-full bg-emerald-400 inline-block animate-pulse"></span>
        <span>Sensor en tiempo real</span>
      </div>
    )}
  </div>
</div>
