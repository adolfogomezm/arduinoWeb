---
import type { Lectura } from '../types/api';

interface Props {
  lecturas: Lectura[];
}

const { lecturas = [] } = Astro.props;

// Sort oldest to newest for chart display
const sorted = [...lecturas].reverse();

const temps = sorted.map(l => l.temperatura);
const hums = sorted.map(l => l.humedad);

const latestTemp = temps.length ? temps[temps.length - 1].toFixed(1) : '--';
const latestHum = hums.length ? hums[hums.length - 1].toFixed(0) : '--';

const minTemp = temps.length ? Math.min(...temps) : 0;
const maxTemp = temps.length ? Math.max(...temps) : 0;
const minHum = hums.length ? Math.min(...hums) : 0;
const maxHum = hums.length ? Math.max(...hums) : 0;

// Dynamic temperature scaling
const tempPadding = Math.max(2, (maxTemp - minTemp) * 0.1);
const lowerBound = Math.floor(minTemp - tempPadding);
const upperBound = Math.ceil(maxTemp + tempPadding);
const tempRange = Math.max(upperBound - lowerBound, 1);
---

<div class="rounded-2xl bg-slate-900/70 border border-slate-800 p-5 sm:p-6 backdrop-blur-md shadow-xl shadow-black/20">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-6">
    <div>
      <h3 class="text-base font-bold text-white flex items-center gap-2">
        <svg class="w-5 h-5 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
        </svg>
        Tendencia Reciente
      </h3>
      <p class="text-xs text-slate-400 mt-0.5">Evolución de temperatura y humedad en las últimas lecturas</p>
    </div>
    
    <div class="flex items-center gap-4 text-xs font-medium">
      <div class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-amber-400 shadow-[0_0_8px_rgba(251,191,36,0.6)]"></span>
        <span class="text-slate-300">Temp (°C)</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 shadow-[0_0_8px_rgba(34,211,238,0.6)]"></span>
        <span class="text-slate-300">Humedad (%)</span>
      </div>
    </div>
  </div>

  <div id="chart-container">
    {sorted.length === 0 ? (
      <div id="chart-empty" class="h-48 flex flex-col items-center justify-center text-slate-500 text-sm gap-2">
        <svg class="w-8 h-8 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
        </svg>
        <span>Sin datos registrados para graficar</span>
      </div>
    ) : (
      <div id="chart-grid" class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <!-- Temperatura Card -->
        <div class="bg-slate-950/60 border border-slate-800/80 rounded-2xl p-4 sm:p-5 flex flex-col justify-between">
          <div class="flex items-center justify-between mb-4">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-amber-400 flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                Temperatura
              </span>
              <span class="text-[11px] text-slate-500 font-mono block mt-0.5">
                Mín: {minTemp}° · Máx: {maxTemp}°
              </span>
            </div>
            <div class="px-2.5 py-1 rounded-lg bg-amber-500/10 border border-amber-500/20 text-amber-300 font-mono text-xs font-semibold">
              {latestTemp}°C actual
            </div>
          </div>

          <!-- Chart Area -->
          <div class="relative pt-6 pb-1">
            <!-- Background reference lines -->
            <div class="absolute inset-x-0 top-6 bottom-7 flex flex-col justify-between pointer-events-none opacity-20">
              <div class="border-b border-dashed border-slate-500 w-full"></div>
              <div class="border-b border-dashed border-slate-500 w-full"></div>
              <div class="border-b border-dashed border-slate-500 w-full"></div>
            </div>

            <!-- Bars container -->
            <div id="chart-temp-bars" class="relative z-10 flex items-end justify-between gap-1.5 sm:gap-2 h-36">
              {sorted.map((item) => {
                const heightPct = Math.max(6, Math.min(100, Math.round(((item.temperatura - lowerBound) / tempRange) * 100)));
                const hora = (item.fecha_hora.split(' ')[1] || '').slice(0, 5);

                return (
                  <div class="flex-1 flex flex-col items-center h-full justify-end group relative min-w-[12px]">
                    <!-- Floating hover tooltip -->
                    <div class="opacity-0 group-hover:opacity-100 transition-all duration-200 pointer-events-none absolute -top-5 z-30 bg-slate-900 border border-slate-700 text-amber-300 font-mono text-[10px] px-1.5 py-0.5 rounded shadow-xl whitespace-nowrap">
                      {item.temperatura}°C
                    </div>

                    <!-- Bar Track -->
                    <div class="w-full max-w-[24px] h-28 bg-slate-800/40 rounded-t-md overflow-hidden flex items-end border-t border-slate-700/30 group-hover:bg-slate-800/70 transition-colors">
                      <div
                        class="w-full bg-gradient-to-t from-amber-600 via-orange-500 to-amber-400 rounded-t-sm transition-all duration-500 group-hover:brightness-125 group-hover:shadow-[0_0_12px_rgba(245,158,11,0.5)]"
                        style={`height: ${heightPct}%; min-height: 4px;`}
                      ></div>
                    </div>

                    <!-- Timestamp -->
                    <span class="text-[9px] font-mono text-slate-500 group-hover:text-slate-300 transition-colors truncate w-full text-center mt-1.5">
                      {hora}
                    </span>
                  </div>
                );
              })}
            </div>
          </div>
        </div>

        <!-- Humedad Card -->
        <div class="bg-slate-950/60 border border-slate-800/80 rounded-2xl p-4 sm:p-5 flex flex-col justify-between">
          <div class="flex items-center justify-between mb-4">
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-cyan-400 flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
                Humedad Relativa
              </span>
              <span class="text-[11px] text-slate-500 font-mono block mt-0.5">
                Mín: {minHum}% · Máx: {maxHum}%
              </span>
            </div>
            <div class="px-2.5 py-1 rounded-lg bg-cyan-500/10 border border-cyan-500/20 text-cyan-300 font-mono text-xs font-semibold">
              {latestHum}% actual
            </div>
          </div>

          <!-- Chart Area -->
          <div class="relative pt-6 pb-1">
            <!-- Background reference lines -->
            <div class="absolute inset-x-0 top-6 bottom-7 flex flex-col justify-between pointer-events-none opacity-20">
              <div class="border-b border-dashed border-slate-500 w-full"></div>
              <div class="border-b border-dashed border-slate-500 w-full"></div>
              <div class="border-b border-dashed border-slate-500 w-full"></div>
            </div>

            <!-- Bars container -->
            <div id="chart-hum-bars" class="relative z-10 flex items-end justify-between gap-1.5 sm:gap-2 h-36">
              {sorted.map((item) => {
                const heightPct = Math.max(6, Math.min(100, Math.round(item.humedad)));
                const hora = (item.fecha_hora.split(' ')[1] || '').slice(0, 5);

                return (
                  <div class="flex-1 flex flex-col items-center h-full justify-end group relative min-w-[12px]">
                    <!-- Floating hover tooltip -->
                    <div class="opacity-0 group-hover:opacity-100 transition-all duration-200 pointer-events-none absolute -top-5 z-30 bg-slate-900 border border-slate-700 text-cyan-300 font-mono text-[10px] px-1.5 py-0.5 rounded shadow-xl whitespace-nowrap">
                      {item.humedad}%
                    </div>

                    <!-- Bar Track -->
                    <div class="w-full max-w-[24px] h-28 bg-slate-800/40 rounded-t-md overflow-hidden flex items-end border-t border-slate-700/30 group-hover:bg-slate-800/70 transition-colors">
                      <div
                        class="w-full bg-gradient-to-t from-blue-600 via-cyan-500 to-teal-400 rounded-t-sm transition-all duration-500 group-hover:brightness-125 group-hover:shadow-[0_0_12px_rgba(6,182,212,0.5)]"
                        style={`height: ${heightPct}%; min-height: 4px;`}
                      ></div>
                    </div>

                    <!-- Timestamp -->
                    <span class="text-[9px] font-mono text-slate-500 group-hover:text-slate-300 transition-colors truncate w-full text-center mt-1.5">
                      {hora}
                    </span>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>
    )}
  </div>
</div>
