---
interface Props {
  speed: string;
  size?: 'sm' | 'md' | 'lg';
}

const { speed, size = 'md' } = Astro.props;

const normalized = (speed || '').toLowerCase().trim();

let colorClasses = 'bg-slate-800 text-slate-300 border-slate-700';
let animClass = '';
let dotColor = 'bg-slate-400';

if (normalized.includes('alta') || normalized === 'high') {
  colorClasses = 'bg-rose-500/15 text-rose-300 border-rose-500/30';
  animClass = 'animate-spin-fast';
  dotColor = 'bg-rose-400';
} else if (normalized.includes('media') || normalized === 'medium') {
  colorClasses = 'bg-amber-500/15 text-amber-300 border-amber-500/30';
  animClass = 'animate-spin-medium';
  dotColor = 'bg-amber-400';
} else if (normalized.includes('baja') || normalized === 'low') {
  colorClasses = 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30';
  animClass = 'animate-spin-slow';
  dotColor = 'bg-emerald-400';
}

const sizeClasses = {
  sm: 'text-xs px-2.5 py-0.5 gap-1.5',
  md: 'text-xs px-3 py-1.5 gap-2 font-medium',
  lg: 'text-sm px-4 py-2 gap-2.5 font-semibold',
}[size];

const iconSizes = {
  sm: 'w-3.5 h-3.5',
  md: 'w-4 h-4',
  lg: 'w-5 h-5',
}[size];
---

<span class={`inline-flex items-center rounded-full border backdrop-blur-sm uppercase tracking-wider transition-all duration-300 ${colorClasses} ${sizeClasses}`}>
  <svg class={`${iconSizes} ${animClass}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <!-- Fan blades icon -->
    <path d="M12 12c0-3 2.5-5 5-5s3 2.5 3 5-2.5 5-5 5c0 3-2.5 5-5 5s-3-2.5-3-5 2.5-5 5-5c0-3-2.5-5-5-5s-3 2.5-3 5 2.5 5 5 5"></path>
    <circle cx="12" cy="12" r="2"></circle>
  </svg>
  <span>{speed || 'Desconocido'}</span>
</span>
