---
import type { Lectura } from '../types/api';
import FanBadge from './FanBadge.astro';

interface Props {
  lecturas: Lectura[];
}

const { lecturas = [] } = Astro.props;
---

<div class="relative overflow-hidden rounded-2xl bg-slate-900/70 border border-slate-800 backdrop-blur-md shadow-xl shadow-black/20">
  <div class="p-5 sm:p-6 border-b border-slate-800/80 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div>
      <h2 class="text-lg font-bold text-white flex items-center gap-2">
        <svg class="w-5 h-5 text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
        Historial de Lecturas
      </h2>
      <p class="text-xs text-slate-400 mt-0.5">Registro cronológico de telemetría del ventilador y sensores</p>
    </div>
    <div class="text-xs text-slate-400 bg-slate-800/60 px-3 py-1.5 rounded-lg border border-slate-700/50 self-start sm:self-auto font-mono">
      {lecturas.length} {lecturas.length === 1 ? 'registro' : 'registros'}
    </div>
  </div>

  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse">
      <thead>
        <tr class="bg-slate-950/50 border-b border-slate-800/80 text-xs font-semibold text-slate-400 uppercase tracking-wider">
          <th class="py-3.5 px-4 sm:px-6">Fecha y Hora</th>
          <th class="py-3.5 px-4 sm:px-6">Temperatura</th>
          <th class="py-3.5 px-4 sm:px-6">Humedad</th>
          <th class="py-3.5 px-4 sm:px-6">Velocidad</th>
          <th class="py-3.5 px-4 sm:px-6 text-right">Timestamp</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800/60 text-sm">
        {lecturas.length === 0 ? (
          <tr>
            <td colspan="5" class="py-12 text-center text-slate-500">
              No hay lecturas disponibles en este momento.
            </td>
          </tr>
        ) : (
          lecturas.map((item, index) => {
            // Calculate humidity percentage for mini bar
            const humPct = Math.min(Math.max(item.humedad, 0), 100);
            const isFirst = index === 0;

            return (
              <tr class={`transition-colors hover:bg-slate-800/40 ${isFirst ? 'bg-cyan-500/5 font-medium' : ''}`}>
                <td class="py-4 px-4 sm:px-6 whitespace-nowrap">
                  <div class="flex items-center gap-2">
                    {isFirst && (
                      <span class="inline-block w-2 h-2 rounded-full bg-cyan-400 animate-pulse" title="Lectura más reciente"></span>
                    )}
                    <span class="font-mono text-slate-200">{item.fecha_hora}</span>
                  </div>
                </td>
                <td class="py-4 px-4 sm:px-6 whitespace-nowrap">
                  <div class="inline-flex items-center gap-1.5 font-mono">
                    <span class={`font-semibold ${item.temperatura >= 27 ? 'text-rose-400' : item.temperatura >= 23 ? 'text-amber-400' : 'text-emerald-400'}`}>
                      {item.temperatura.toFixed(1)}°C
                    </span>
                  </div>
                </td>
                <td class="py-4 px-4 sm:px-6 whitespace-nowrap">
                  <div class="flex items-center gap-3">
                    <span class="font-mono text-cyan-300 font-semibold w-12">{item.humedad.toFixed(0)}%</span>
                    <div class="w-20 bg-slate-800 rounded-full h-1.5 overflow-hidden hidden sm:block">
                      <div class="bg-cyan-400 h-full rounded-full" style={`width: ${humPct}%`}></div>
                    </div>
                  </div>
                </td>
                <td class="py-4 px-4 sm:px-6 whitespace-nowrap">
                  <FanBadge speed={item.velocidad_ventilador} size="sm" />
                </td>
                <td class="py-4 px-4 sm:px-6 whitespace-nowrap text-right font-mono text-xs text-slate-500">
                  {item.timestamp ? item.timestamp.toFixed(2) : '-'}
                </td>
              </tr>
            );
          })
        )}
      </tbody>
    </table>
  </div>
</div>
