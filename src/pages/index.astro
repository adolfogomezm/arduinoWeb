---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import HistoryTable from '../components/HistoryTable.astro';
import TelemetryChart from '../components/TelemetryChart.astro';
import type { ApiResponse, Lectura, Estadisticas } from '../types/api';

const API_URL = 'https://arduino-iot-ventilador-api.onrender.com/historial';

let data: ApiResponse | null = null;
let error: string | null = null;

try {
  const controller = new AbortController();
  const timeoutId = setTimeout(() => controller.abort(), 12000);

  const res = await fetch(API_URL, {
    signal: controller.signal,
    headers: { 'Accept': 'application/json' },
  });
  clearTimeout(timeoutId);

  if (res.ok) {
    data = await res.json();
  } else {
    throw new Error(`Código ${res.status}`);
  }
} catch (err: any) {
  error = 'El servidor está iniciando o no responde. Reintentando...';
}

const lecturas: Lectura[] = data?.lecturas || [];
const latestReading = lecturas.length > 0 ? lecturas[0] : null;
const initialTimestamp = latestReading?.timestamp || 0;

let stats: Estadisticas | null = data?.estadisticas || null;
if (!stats && lecturas.length > 0) {
  const temps = lecturas.map(l => l.temperatura);
  const hums = lecturas.map(l => l.humedad);
  stats = {
    temperatura_promedio: Number((temps.reduce((a, b) => a + b, 0) / temps.length).toFixed(1)),
    humedad_promedio: Number((hums.reduce((a, b) => a + b, 0) / hums.length).toFixed(1)),
    temperatura_min: Math.min(...temps),
    temperatura_max: Math.max(...temps),
    humedad_min: Math.min(...hums),
    humedad_max: Math.max(...hums),
  };
}

const fanSpeed = (latestReading?.velocidad_ventilador || 'baja').toLowerCase().trim();

const speedConfig: Record<string, { label: string; badge: string; spin: string; duration: string }> = {
  alta: { 
    label: 'ALTA', 
    badge: 'bg-rose-500/20 text-rose-400 border-rose-500/30', 
    spin: 'animate-spin-fast',
    duration: '0.6s'
  },
  media: { 
    label: 'MEDIA', 
    badge: 'bg-blue-500/20 text-blue-400 border-blue-500/30', 
    spin: 'animate-spin-medium',
    duration: '2.0s'
  },
  baja: { 
    label: 'BAJA', 
    badge: 'bg-emerald-500/20 text-emerald-400 border-emerald-500/30', 
    spin: 'animate-spin-slow',
    duration: '4.5s'
  },
};
const currentConfig = speedConfig[fanSpeed] || speedConfig.baja;
---

<Layout title="Control de Climatización Inteligente">
  <main 
    id="dashboard-root" 
    data-initial-timestamp={initialTimestamp}
    class="min-h-screen bg-[#0b0f19] text-slate-100 pb-16 selection:bg-cyan-500 selection:text-black"
  >
    
    <!-- Barra Superior -->
    <header class="sticky top-0 z-40 bg-[#0b0f19]/80 backdrop-blur-md border-b border-slate-800/60 px-4 sm:px-8 py-3.5 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center shadow-lg shadow-cyan-500/25">
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <div>
          <h1 class="text-sm sm:text-base font-bold text-white tracking-wide">Climatización IoT</h1>
          <div class="flex items-center gap-1.5">
            <span id="status-indicator" class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span id="status-text" class="text-[11px] font-medium text-slate-400">En línea (cada 15s)</span>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <button 
          id="btn-sync" 
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-800/80 hover:bg-slate-700/80 border border-slate-700/50 text-xs font-medium text-slate-200 transition active:scale-95"
          title="Actualizar ahora"
        >
          <svg id="sync-icon" class="w-3.5 h-3.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          <span class="hidden sm:inline">Actualizar</span>
        </button>
      </div>
    </header>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 space-y-6">

      {error && (
        <div id="error-banner" class="p-3.5 rounded-2xl bg-amber-500/10 border border-amber-500/20 text-amber-300 text-xs flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-amber-500 animate-ping"></span>
          <span id="error-message">{error}</span>
        </div>
      )}

      <!-- PANEL PRINCIPAL -->
      <section class="grid grid-cols-1 lg:grid-cols-12 gap-5">
        
        <!-- Tarjeta del Ventilador -->
        <div class="lg:col-span-7 rounded-3xl bg-slate-900/90 border border-slate-800/80 p-6 sm:p-8 flex flex-col justify-between relative overflow-hidden shadow-2xl">
          <div class="flex items-center justify-between mb-6">
            <div>
              <span class="text-xs uppercase font-semibold text-slate-400 tracking-wider">Actuador Inteligente</span>
              <h2 class="text-xl font-bold text-white mt-0.5">Control de Ventilación</h2>
            </div>
            <span id="fan-badge" class={`text-xs font-bold uppercase px-3 py-1 rounded-full border ${currentConfig.badge}`}>
              Nivel: {currentConfig.label}
            </span>
          </div>

          <div class="flex flex-col sm:flex-row items-center justify-center gap-8 py-4">
            <div class="w-36 h-36 rounded-full border border-slate-800 flex items-center justify-center bg-slate-950/50 shadow-inner">
              <svg 
                id="fan-icon" 
                class={`w-20 h-20 text-cyan-400 animate-spin ${currentConfig.spin}`} 
                style={`animation-duration: ${currentConfig.duration};`}
                fill="currentColor" 
                viewBox="0 0 24 24"
              >
                <path d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2zm1 14.93a3 3 0 0 1-2 0V13a1 1 0 0 1 2 0v3.93zM8.54 15.6a3 3 0 0 1-1.42-1.41L10 12a1 1 0 0 1 .71 1.29zm0-7.2L10.71 10.7A1 1 0 0 1 10 12L7.12 9.81a3 3 0 0 1 1.42-1.41zM13 7.07V11a1 1 0 0 1-2 0V7.07a3 3 0 0 1 2 0zm2.46 1.33 1.42 1.41L14 12a1 1 0 0 1-.71-1.29zm0 7.2-2.17-2.29A1 1 0 0 1 14 12l2.88 2.19a3 3 0 0 1-1.42 1.41z" />
              </svg>
            </div>

            <div class="space-y-3 text-center sm:text-left">
              <div class="text-xs text-slate-400">Algoritmo de Decisión:</div>
              <div class="text-sm font-semibold text-slate-200 bg-slate-800/40 px-3 py-1.5 rounded-xl border border-slate-700/40 inline-block font-mono">
                Lógica Difusa (Mamdani)
              </div>
              <p class="text-xs text-slate-400 max-w-xs leading-relaxed">
                El sistema evalúa temperatura y humedad mediante reglas difusas para modular la ventilación.
              </p>
            </div>
          </div>

          <div class="pt-4 border-t border-slate-800/60 flex items-center justify-between text-xs text-slate-400">
            <span>Última sincronización</span>
            <span id="last-sync-time" class="font-mono text-slate-300">
              {latestReading?.fecha_hora || '--:--:--'}
            </span>
          </div>
        </div>

        <!-- Tarjetas de Sensores -->
        <div class="lg:col-span-5 flex flex-col gap-4">
          <!-- Temp -->
          <div class="flex-1 rounded-3xl bg-slate-900/80 border border-slate-800/80 p-5 sm:p-6 flex items-center justify-between shadow-lg">
            <div class="space-y-1">
              <span class="text-xs uppercase font-semibold text-slate-400 tracking-wider">Temperatura Actual</span>
              <div class="flex items-baseline gap-1">
                <span id="live-temp" class="text-4xl sm:text-5xl font-black font-mono text-amber-400">
                  {latestReading ? latestReading.temperatura.toFixed(1) : '--'}
                </span>
                <span class="text-lg font-bold text-amber-400/80">°C</span>
              </div>
              <div class="text-xs text-slate-500 pt-1 flex gap-3">
                <span>Mín: <strong id="temp-min" class="text-slate-300">{stats?.temperatura_min ?? '--'}°</strong></span>
                <span>Máx: <strong id="temp-max" class="text-slate-300">{stats?.temperatura_max ?? '--'}°</strong></span>
              </div>
            </div>
          </div>

          <!-- Humedad -->
          <div class="flex-1 rounded-3xl bg-slate-900/80 border border-slate-800/80 p-5 sm:p-6 flex items-center justify-between shadow-lg">
            <div class="space-y-1">
              <span class="text-xs uppercase font-semibold text-slate-400 tracking-wider">Humedad Relativa</span>
              <div class="flex items-baseline gap-1">
                <span id="live-hum" class="text-4xl sm:text-5xl font-black font-mono text-cyan-400">
                  {latestReading ? latestReading.humedad.toFixed(0) : '--'}
                </span>
                <span class="text-lg font-bold text-cyan-400/80">%</span>
              </div>
              <div class="text-xs text-slate-500 pt-1 flex gap-3">
                <span>Mín: <strong id="hum-min" class="text-slate-300">{stats?.humedad_min ?? '--'}%</strong></span>
                <span>Máx: <strong id="hum-max" class="text-slate-300">{stats?.humedad_max ?? '--'}%</strong></span>
              </div>
            </div>
          </div>
        </div>

      </section>

      <!-- Gráfico -->
      <section class="space-y-4">
        <h3 class="text-base font-bold text-slate-200">Gráfico de Telemetría (1 Hora)</h3>
        <TelemetryChart lecturas={lecturas} />
      </section>

      <!-- Tabla -->
      <section class="space-y-3">
        <h3 class="text-base font-bold text-slate-200">Lecturas Recientes</h3>
        <HistoryTable lecturas={lecturas} />
      </section>

      <!-- Pie de página con bandera y dedicatoria -->
      <footer class="mt-12 pt-6 border-t border-slate-800/60 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
        <div class="flex items-center gap-2.5">
          <span>Sistema de Telemetría IoT</span>
          <span class="text-slate-700">•</span>
          <!-- Bandera de Ucrania minimalista -->
          <span class="inline-flex items-center px-1.5 py-1 rounded-md bg-slate-900 border border-slate-800 shadow-sm" title="Україна">
            <span class="w-4 h-2.5 rounded-[2px] overflow-hidden flex flex-col border border-slate-700/60">
              <span class="h-1/2 bg-[#0057B7] w-full"></span>
              <span class="h-1/2 bg-[#FFD700] w-full"></span>
            </span>
          </span>
        </div>
        
        <div class="font-mono text-[11px] text-slate-400">
          <span>З любов'ю</span>
        </div>
      </footer>

    </div>
  </main>

  <script>
    const POLL_INTERVAL_MS = 15000; // Consulta cada 15 segundos
    const rootEl = document.getElementById('dashboard-root');
    const initialTimestamp = Number(rootEl?.dataset.initialTimestamp || 0);

    const btnSync = document.getElementById('btn-sync');
    const syncIcon = document.getElementById('sync-icon');

    // Botón manual de actualizar: recarga la página inmediatamente
    if (btnSync) {
      btnSync.addEventListener('click', () => {
        if (syncIcon) syncIcon.classList.add('rotate-180');
        window.location.reload();
      });
    }

    // Monitoreo en segundo plano cada 15s:
    // Consulta si hay lecturas nuevas y solo reinicia la página si llegó un dato nuevo
    async function verificarNuevosDatos() {
      try {
        const res = await fetch('/api/historial', {
          headers: { 'Accept': 'application/json' },
          cache: 'no-store',
        });
        if (!res.ok) return;

        const data = await res.json();
        if (data && data.lecturas && data.lecturas.length > 0) {
          const ultimaLectura = data.lecturas[0];
          const nuevoTimestamp = Number(ultimaLectura.timestamp) || 0;

          // Si el timestamp es diferente al que cargó el SSR en la página,
          // recarga la página completa para que Astro SSR configure todo (ventilador, gráfico, tabla, etc.)
          if (nuevoTimestamp > 0 && nuevoTimestamp !== initialTimestamp) {
            console.log('Nuevo dato detectado desde Arduino. Recargando página...');
            window.location.reload();
          }
        }
      } catch (err) {
        console.warn('Error al verificar actualización:', err);
      }
    }

    setInterval(verificarNuevosDatos, POLL_INTERVAL_MS);
  </script>
</Layout>
