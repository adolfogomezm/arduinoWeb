---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import StatCard from '../components/StatCard.astro';
import FanBadge from '../components/FanBadge.astro';
import HistoryTable from '../components/HistoryTable.astro';
import TelemetryChart from '../components/TelemetryChart.astro';
import type { ApiResponse, Lectura, Estadisticas } from '../types/api';

const API_URL = 'https://arduino-iot-ventilador-api.onrender.com/historial';

let data: ApiResponse | null = null;
let error: string | null = null;
const fetchTime = new Date().toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit', second: '2-digit' });

try {
  const controller = new AbortController();
  const timeoutId = setTimeout(() => controller.abort(), 12000);

  const res = await fetch(API_URL, {
    signal: controller.signal,
    headers: {
      'Accept': 'application/json',
      'User-Agent': 'Astro-SSR-Dashboard/1.0',
    },
  });

  clearTimeout(timeoutId);

  if (!res.ok) {
    throw new Error(`Error en API (${res.status} ${res.statusText})`);
  }

  data = await res.json();
} catch (err: any) {
  console.error('Error al obtener datos de la API:', err.message);
  error = err.name === 'AbortError' 
    ? 'El servidor de la API tardó más de 12s en responder (posible inicio en frío de Render).'
    : `No se pudo conectar con la API: ${err.message}`;
}

const lecturas: Lectura[] = data?.lecturas || [];
const totalLecturas = data?.total_lecturas ?? lecturas.length;

// If stats are provided by API, use them; otherwise calculate if we have readings
let stats: Estadisticas | null = data?.estadisticas || null;
if (!stats && lecturas.length > 0) {
  const temps = lecturas.map(l => l.temperatura);
  const hums = lecturas.map(l => l.humedad);
  stats = {
    temperatura_promedio: Number((temps.reduce((a, b) => a + b, 0) / temps.length).toFixed(1)),
    humedad_promedio: Number((hums.reduce((a, b) => a + b, 0) / hums.length).toFixed(1)),
    temperatura_min: Math.min(...temps),
    temperatura_max: Math.max(...temps),
    humedad_min: Math.min(...hums),
    humedad_max: Math.max(...hums),
  };
}

const latestReading = lecturas.length > 0 ? lecturas[0] : null;
---

<Layout title="Arduino IoT - Monitor de Ventilador y Sensores">
  <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    
    <!-- Top Header -->
    <header class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-slate-800/80">
      <div class="flex items-center gap-3.5">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center shadow-lg shadow-cyan-500/20 text-white flex-shrink-0">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="6" width="20" height="12" rx="2"></rect>
            <circle cx="7" cy="12" r="1"></circle>
            <circle cx="17" cy="12" r="1"></circle>
            <path d="M12 9v6"></path>
          </svg>
        </div>
        <div>
          <div class="flex items-center gap-2.5 flex-wrap">
            <h1 class="text-2xl font-extrabold tracking-tight text-white">Arduino IoT Ventilador</h1>
            <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 tracking-wider uppercase font-mono">
              SSR Activo
            </span>
            <span class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 border border-slate-700/60 font-mono">
              Ventana móvil 1h
            </span>
          </div>
          <p class="text-xs text-slate-400 mt-1">Dashboard de telemetría y control ambiental</p>
        </div>
      </div>

      <!-- Actions & Server Status -->
      <div class="flex items-center flex-wrap gap-3">
        <!-- Live status badge -->
        <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-900 border border-slate-800 text-xs font-medium">
          <span class={`w-2.5 h-2.5 rounded-full ${error ? 'bg-rose-500' : 'bg-emerald-400 animate-pulse'}`}></span>
          <span class={error ? 'text-rose-400' : 'text-emerald-400'}>
            {error ? 'Error de Conexión' : 'API Conectada'}
          </span>
          <span class="text-slate-700">|</span>
          <span class="text-slate-400 font-mono text-[11px]">{fetchTime}</span>
        </div>

        <!-- Auto-refresh Toggle -->
        <label class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-slate-900 border border-slate-800 text-xs text-slate-300 cursor-pointer select-none hover:border-slate-700 transition">
          <input type="checkbox" id="auto-refresh-toggle" class="accent-cyan-500 rounded" />
          <span>Auto-recarga (10s)</span>
        </label>

        <!-- Manual reload button -->
        <button
          onclick="window.location.reload()"
          class="flex items-center gap-2 px-4 py-1.5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-500 hover:from-cyan-400 hover:to-blue-400 text-slate-950 font-semibold text-xs transition duration-200 shadow-md shadow-cyan-500/20 active:scale-95"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"></path>
          </svg>
          Actualizar
        </button>
      </div>
    </header>

    <!-- Error Banner -->
    {error && (
      <div class="p-4 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-300 flex items-start gap-3">
        <svg class="w-5 h-5 flex-shrink-0 mt-0.5 text-rose-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="8" x2="12" y2="12"></line>
          <line x1="12" y1="16" x2="12.01" y2="16"></line>
        </svg>
        <div class="text-xs sm:text-sm">
          <p class="font-bold">Aviso del servidor:</p>
          <p class="mt-0.5 text-rose-200/90">{error}</p>
          <p class="mt-2 text-slate-400 text-xs">
            Si la API en Render estaba en reposo (free tier), puede tardar hasta 40 segundos en reactivarse.
          </p>
        </div>
      </div>
    )}

    <!-- Empty state notice when API is up but has 0 readings in the last hour -->
    {!error && lecturas.length === 0 && (
      <div class="p-6 rounded-2xl bg-slate-900/50 border border-slate-800 text-center space-y-3">
        <div class="w-12 h-12 mx-auto rounded-full bg-cyan-500/10 flex items-center justify-center text-cyan-400">
          <svg class="w-6 h-6 animate-pulse" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
          </svg>
        </div>
        <h3 class="text-base font-bold text-white">Esperando lecturas del sensor Arduino</h3>
        <p class="text-xs text-slate-400 max-w-md mx-auto">
          La API mantiene una <strong class="text-slate-300">ventana móvil de 1 hora</strong>. Tan pronto como el Arduino envíe un POST a <code class="text-cyan-300 bg-slate-800 px-1 py-0.5 rounded font-mono">/datos</code>, las estadísticas y gráficos aparecerán automáticamente aquí.
        </p>
      </div>
    )}

    <!-- Latest Reading Hero Highlight -->
    {latestReading && (
      <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-900/90 via-slate-900/60 to-slate-950 border border-slate-800 p-6 sm:p-8 backdrop-blur-xl shadow-2xl shadow-black/40">
        <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-cyan-500/5 rounded-full blur-2xl pointer-events-none"></div>

        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
          <div class="space-y-2">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-cyan-400 animate-ping"></span>
              <span class="text-xs font-bold uppercase tracking-wider text-cyan-400">Última Lectura Registrada</span>
            </div>
            <div class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
              Estado en Directo
            </div>
            <p class="text-xs sm:text-sm text-slate-400 font-mono flex items-center gap-2">
              <svg class="w-4 h-4 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              {latestReading.fecha_hora}
            </p>
          </div>

          <!-- Highlight metrics cards -->
          <div class="grid grid-cols-3 gap-3 sm:gap-6 bg-slate-950/60 border border-slate-800/80 p-4 rounded-2xl">
            <!-- Current Temp -->
            <div class="text-center px-2">
              <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider block mb-1">Temperatura</span>
              <span class="text-2xl sm:text-3xl font-extrabold font-mono text-orange-400">
                {latestReading.temperatura.toFixed(1)}°C
              </span>
            </div>

            <!-- Current Humidity -->
            <div class="text-center px-2 border-x border-slate-800">
              <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider block mb-1">Humedad</span>
              <span class="text-2xl sm:text-3xl font-extrabold font-mono text-cyan-400">
                {latestReading.humedad.toFixed(0)}%
              </span>
            </div>

            <!-- Current Fan Speed -->
            <div class="text-center px-2 flex flex-col items-center justify-center">
              <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider block mb-1">Ventilador</span>
              <FanBadge speed={latestReading.velocidad_ventilador} size="md" />
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- KPI Statistics Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      <StatCard
        title="Temp. Promedio"
        value={stats ? stats.temperatura_promedio.toFixed(1) : '--'}
        unit={stats ? '°C' : ''}
        min={stats?.temperatura_min}
        max={stats?.temperatura_max}
        type="temperature"
      />
      <StatCard
        title="Humedad Promedio"
        value={stats ? stats.humedad_promedio.toFixed(1) : '--'}
        unit={stats ? '%' : ''}
        min={stats?.humedad_min}
        max={stats?.humedad_max}
        type="humidity"
      />
      <StatCard
        title="Ventilador Actual"
        value={latestReading ? latestReading.velocidad_ventilador.toUpperCase() : 'INACTIVO'}
        type="fan"
      />
      <StatCard
        title="Total de Lecturas"
        value={totalLecturas}
        type="count"
      />
    </div>

    <!-- Charts / Trends Section -->
    <TelemetryChart lecturas={lecturas} />

    <!-- History Table -->
    <HistoryTable lecturas={lecturas} />

    <!-- Footer -->
    <footer class="pt-6 pb-4 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-slate-500">
      <div>
        <span>Desarrollado con </span>
        <a href="https://astro.build" target="_blank" rel="noopener noreferrer" class="text-slate-400 hover:text-cyan-400 underline decoration-slate-700">Astro SSR</a>
        <span> y Tailwind CSS</span>
      </div>
      <div class="flex items-center gap-3">
        <span>Origen de datos:</span>
        <a 
          href={API_URL} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="font-mono text-cyan-400 hover:underline flex items-center gap-1"
        >
          API Historial
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
            <polyline points="15 3 21 3 21 9"></polyline>
            <line x1="10" y1="14" x2="21" y2="3"></line>
          </svg>
        </a>
      </div>
    </footer>

  </div>

  <!-- Client-side auto-refresh script -->
  <script>
    const checkbox = document.getElementById('auto-refresh-toggle') as HTMLInputElement | null;
    let intervalId: any = null;

    if (checkbox) {
      // Restore previous state if saved
      const savedState = localStorage.getItem('auto_refresh_dashboard');
      if (savedState === 'true') {
        checkbox.checked = true;
        startAutoRefresh();
      }

      checkbox.addEventListener('change', () => {
        localStorage.setItem('auto_refresh_dashboard', checkbox.checked ? 'true' : 'false');
        if (checkbox.checked) {
          startAutoRefresh();
        } else {
          stopAutoRefresh();
        }
      });
    }

    function startAutoRefresh() {
      if (intervalId) clearInterval(intervalId);
      intervalId = setInterval(() => {
        window.location.reload();
      }, 10000); // 10 seconds
    }

    function stopAutoRefresh() {
      if (intervalId) {
        clearInterval(intervalId);
        intervalId = null;
      }
    }
  </script>
</Layout>
